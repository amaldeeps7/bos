# Business OS on a server (staging or production). Copy to .env in the repository root on the server:
#   cp deploy/.env.production.example .env && chmod 600 .env
# Never commit the filled-in file. Make each secret with:  openssl rand -hex 32

# ── Address ────────────────────────────────────────────────────────────────
# The domain people open (its DNS A record points at this server). No https://, no trailing slash.
DOMAIN=staging.example.in
# Let's Encrypt sends certificate expiry notices here.
ACME_EMAIL=you@example.in

# ── Secrets (all required) ───────────────────────────────────────────────────
# Database owner (migrations) and the app's own role (runs with row-level security).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# Signs sessions. Changing it signs everyone out.
JWT_SECRET=
# Encrypts two-factor secrets and organisations' AI keys at rest. Changing it breaks those: set once, keep it safe, back it up.
MFA_KEY=

# ── Sample data ──────────────────────────────────────────────────────────────
# true on a test server: loads the Demo Consulting workspace (sign in as priya@democonsulting.in / demo1234)
# and its one-click demo accounts. Keep false anywhere real customers sign up.
SEED_DEMO=true
DEMO_MODE=true

# ── Email ────────────────────────────────────────────────────────────────────
# Empty: nothing leaves the server; emails are caught by Mailpit (see deploy/caddy-extra/mailpit.caddy.example).
# Real delivery, e.g. Zoho ZeptoMail, Amazon SES (Mumbai) or Brevo:
#   SMTP_URL=smtps://USERNAME:PASSWORD@smtp.zeptomail.in:465
SMTP_URL=
# Sender shown on every email (the domain should have SPF/DKIM set up with your provider).
EMAIL_FROM="Business OS <no-reply@example.in>"

# ── AI assistant (optional) ──────────────────────────────────────────────────
# A server-wide Anthropic key every organisation uses unless its Owner adds its own in Settings → Organisation → AI assistant.
# Leave empty to let each organisation bring its own key (or use the built-in answers).
ANTHROPIC_API_KEY=

# ── Mailpit behind a password (optional, see deploy/caddy-extra) ───────────────
MAIL_DOMAIN=
MAIL_USER=admin
MAIL_PASSWORD_HASH=

# ── Backups (deploy/backup.sh) ───────────────────────────────────────────────
BACKUP_DIR=/var/backups/bos
BACKUP_KEEP_DAYS=14
# Optional off-site copy with rclone (e.g. a Backblaze B2 or S3 remote set up with `rclone config`): remote:bucket/path
BACKUP_RCLONE_TARGET=
