# Copy to .env for docker compose. All optional.
# Signs sessions. Production refuses to start with a weak value unless DEMO_MODE=true: use `openssl rand -hex 32`.
JWT_SECRET=change-me-in-production
# Encrypts two-factor secrets at rest. Defaults to JWT_SECRET; set its own random value in production.
MFA_KEY=
# Session cookies are Secure (HTTPS only) in production. Compose serves plain http on localhost, so it's off here;
# set true once the app is behind HTTPS.
COOKIE_SECURE=false
# Password for the application's database role (bos_app). Created on first start.
APP_DB_PASSWORD=bos_app
# true: "Approve as Meera (demo)" buttons let one person walk a document through every step.
DEMO_MODE=true
# true: load the Demo Consulting workspace when the database is empty. Existing data is never touched.
SEED_DEMO=true
# Lets the assistant answer free-text questions with Claude.
ANTHROPIC_API_KEY=
# Outgoing email. Defaults to the bundled Mailpit (http://localhost:8025). For real delivery, e.g.:
#   SMTP_URL=smtps://apikey:SECRET@smtp.sendgrid.net:465
SMTP_URL=
EMAIL_FROM="Demo Consulting <billing@democonsulting.in>"
