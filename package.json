{
  "name": "bos",
  "private": true,
  "version": "0.1.0",
  "description": "Business OS — a modular operating system for service businesses",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build:shared": "pnpm --filter @bos/shared build",
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @bos/api dev",
    "dev:web": "pnpm --filter @bos/web dev",
    "db:migrate": "pnpm --filter @bos/api prisma:migrate",
    "db:seed": "pnpm --filter @bos/api seed",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
