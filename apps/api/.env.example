# The API connects as bos_app (no BYPASSRLS) so row-level security applies; migrations and the seed use the owner.
DATABASE_URL=postgresql://bos_app:bos_app@localhost:5432/bos?schema=public
MIGRATE_DATABASE_URL=postgresql://bos:bos@localhost:5432/bos?schema=public
# Data exports are written under STORAGE_DIR/orgs/<orgId>/.
STORAGE_DIR=./storage
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-change-me
# Encrypts two-factor secrets at rest (defaults to JWT_SECRET).
MFA_KEY=
# Background jobs (BullMQ on REDIS_URL): WORKERS=off queues work without running it on this instance;
# SCHEDULER=off stops the once-a-minute reminders and digests.
WORKERS=
WORKER_CONCURRENCY=4
# Requests per minute per IP on every route (sensitive routes have tighter limits); RATE_LIMIT=off disables.
RATE_LIMIT_PER_MIN=600
# Proxy hops in front of the API (load balancer, the web app's /api proxy), so limits see the real client address.
TRUST_PROXY=1
DEMO_MODE=true
PORT=4000
# Leave SMTP_URL empty to log emails without sending them.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Demo Consulting <billing@democonsulting.in>"
WEB_ORIGIN=http://localhost:3000
# Lets the assistant answer free-text questions with Claude.
ANTHROPIC_API_KEY=
